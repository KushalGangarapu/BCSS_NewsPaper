# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API → "anon" "public" key (safe to expose — RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Project Settings → API → "service_role" key.
# SERVER-ONLY. The current code does not use it (all admin work happens under
# the logged-in user's session, so RLS applies). Set it anyway for future use,
# and NEVER prefix it with NEXT_PUBLIC_ or ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Optional. Used for absolute URLs in metadata/sitemap. Defaults to localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
